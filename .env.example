# "npm run worker" is a bare node/tsx process with no framework default for this (unlike
# `next dev`/`next build`/`next start`, which set it themselves) — needed so pg-boss queue
# policy reconciliation (ensureQueue in src/lib/jobs/queues.ts) is allowed to run here.
NODE_ENV="development"

# Postgres (docker-compose defaults)
DATABASE_URL="postgresql://postgres:sdr@localhost:5432/sdr"
TEST_DATABASE_URL="postgresql://postgres:sdr@localhost:5432/sdr_test"

# Disable Next.js telemetry to avoid config file issues on some systems
NEXT_TELEMETRY_DISABLED="1"

# Access gate: the single passphrase and a 32+ char secret for cookie signing + key encryption
APP_PASSPHRASE="change-me"
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Set to 1 behind Railway/any reverse proxy; leave unset when the app is reachable directly.
# Controls whether the passphrase rate limiter trusts x-forwarded-for/x-real-ip for per-client
# throttling keys; untrusted, every client collapses onto one "direct" key and only the global
# limiter applies.
TRUST_PROXY=""

# "real" calls Google; "fake" uses deterministic in-memory providers (tests, demos)
PROVIDER_MODE="fake"
# "queue" enqueues to the pg-boss worker; "inline" runs jobs inside the web process (e2e, no worker)
JOB_MODE="queue"

# Optional in fake mode
GOOGLE_MAPS_API_KEY=""
# Daily budget caps (calls per day)
GOOGLE_DAILY_BUDGET="2000"
